# ─────────────────────────────────────────────
#  LEAD·AI PIPELINE — Environment Variables
#  Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# GROQ
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MAILCHIMP
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
MAILCHIMP_LIST_ID=xxxxxxxxxx

# GMAIL SMTP
# Use an App Password — NOT your real Gmail password
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# WHERE TO SEND THE LEAD REPORT (can be same as GMAIL_USER)
NOTIFY_EMAIL=you@yourdomain.com

# SERVER
PORT=3001
